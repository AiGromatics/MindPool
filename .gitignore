node_modules/
dist/
.vscode-test/
*.vsix
coverage/

# Secrets: credentials must never reach this public repository.
# (Marketplace publish tokens belong in `vsce login` or the VSCE_PAT variable, not in files.)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
